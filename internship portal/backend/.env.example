# SkillBridge Backend Environment Configuration Example
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/skillbridge
# Example MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secure_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# AI Service Configuration
# AI_PROVIDER options: 'gemini', 'openai', or 'rule-based'
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# File Upload Configuration (in bytes, default 5MB)
MAX_FILE_SIZE=5242880
